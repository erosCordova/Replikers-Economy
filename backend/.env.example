# ==========================================================
# Repliker Economy - Backend
# ==========================================================

APP_NAME=Repliker Economy
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./replikers.db
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=300

# Security
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=repliker-economy
JWT_AUDIENCE=repliker-economy-api
JWT_LEEWAY_SECONDS=5

# Refresh sessions
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=repliker_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
MAX_ACTIVE_SESSIONS_PER_USER=5
AUTH_SESSION_HISTORY_DAYS=30

# Anti-abuse
AUTH_LOGIN_IP_MAX_REQUESTS=30
AUTH_LOGIN_IDENTITY_MAX_REQUESTS=10
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_BLOCK_SECONDS=900

AUTH_REGISTER_MAX_REQUESTS=5
AUTH_REGISTER_WINDOW_SECONDS=600
AUTH_REGISTER_BLOCK_SECONDS=1800

AUTH_REFRESH_MAX_REQUESTS=60
AUTH_REFRESH_WINDOW_SECONDS=60
AUTH_REFRESH_BLOCK_SECONDS=300

# Web
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=
ALLOW_INSECURE_LOCAL_ORIGINS=false

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Economy
ECONOMY_MODE=simulation
REAL_PAYMENTS_ENABLED=false
PLATFORM_COMMISSION_BPS=1000
